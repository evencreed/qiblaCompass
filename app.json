{
  "expo": {
    "name": "Qibla Compass",
    "slug": "mobil-uygulama",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qiblacompass",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1519",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to calculate the Qibla direction and prayer times where you are. It never leaves your device."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1519",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "Allowing tracking lets us show ads relevant to your interests. The app works exactly the same if you decline; ads are simply not personalised."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "_comment": "RevenueCat public API keys and production ad units. Left empty, the subscription flow stays disabled and ads fall back to Google test units.",
      "revenueCatIos": "",
      "revenueCatAndroid": "",
      "bannerAdUnitIos": "",
      "bannerAdUnitAndroid": ""
    }
  }
}
